rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O coordenador é definido por um único documento (sistema/coordenador),
    // não por um campo em cada perfil — assim nunca existe ambiguidade sobre
    // quem manda, e transferir o cargo é só trocar esse um valor.
    function souCoordenador() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sistema/coordenador)
        && get(/databases/$(database)/documents/sistema/coordenador).data.uid == request.auth.uid;
    }

    // Membro = logado + tem perfil em /usuarios. Não existe "pendente": ou
    // a pessoa entrou (primeira do sistema, ou usando um convite válido do
    // coordenador) e já é membro pleno, ou não tem perfil nenhum.
    function membro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Projetos: só membro lê ou escreve. Nada de visitante, nada de pendente.
    match /rostag/dados {
      allow read, write: if membro();
    }

    // O documento único que diz quem é o coordenador atual.
    //  - qualquer logado lê (pra saber quem é e mostrar na aba Equipe)
    //  - só é criado uma vez, pelo próprio primeiro usuário (o cadastro dele
    //    grava perfil + coordenador numa transação — ver Auth.cadastrar)
    //  - só o coordenador atual troca o valor, e só pra alguém que já é membro
    match /sistema/coordenador {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/sistema/coordenador)
        && request.resource.data.uid == request.auth.uid;
      allow update: if souCoordenador()
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid));
    }

    // Convites: só o coordenador cria. Quem se cadastra com um código válido
    // (não usado) vira membro na hora — sem aprovação nenhuma depois.
    match /convites/{codigo} {
      allow read: if request.auth != null;
      allow create: if souCoordenador() && request.resource.data.usado == false;
      // marcar como usado: só isso pode mudar, e só quem está virando membro agora
      allow update: if request.auth != null
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
      allow delete: if souCoordenador();
    }

    // Perfis de usuário (nome, preferências):
    //  - qualquer logado lê a lista inteira (é o que alimenta a aba Equipe)
    //  - um usuário cria o próprio perfil só se for o primeiro do sistema
    //    (ainda não existe coordenador) OU se estiver consumindo um convite
    //    válido na mesma transação — sem essas duas condições, não cria
    //  - o dono edita as próprias preferências livremente
    //  - só o coordenador remove alguém (não existe mais "revogar")
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && (
        !exists(/databases/$(database)/documents/sistema/coordenador)
        || (request.resource.data.viaConvite is string
            && exists(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite))
            && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.usado == false)
      );
      allow update: if request.auth != null && (request.auth.uid == uid || souCoordenador());
      allow delete: if souCoordenador();
    }
  }
}
