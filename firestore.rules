rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers
    function membroDe(equipeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid));
    }
    function papelEm(equipeId) {
      return get(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid)).data.papel;
    }
    function souCoordDe(equipeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipes/$(equipeId))
        && get(/databases/$(database)/documents/equipes/$(equipeId)).data.coordenadorUid == request.auth.uid;
    }
    // Coordenador e GP têm o mesmo poder de edição dentro da equipe; planejador
    // só mexe no que for designado a ele (ver regra de /projetos abaixo).
    function souGPouCoordDe(equipeId) {
      return membroDe(equipeId) && (souCoordDe(equipeId) || papelEm(equipeId) == 'gp');
    }
    // Convite válido, já consumido por mim, pra essa equipe e com esse papel —
    // usado tanto pra criar meu /membros/{uid} quanto meu índice pessoal.
    function convitePraMim(equipeId, papelAlvo) {
      return request.resource.data.viaConvite is string
        && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.equipeId == equipeId
        && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.usadoPor == request.auth.uid
        && request.resource.data.papel == papelAlvo
        && papelAlvo == get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.papel;
    }
    // Segunda forma de entrar numa equipe (além do link de convite): nome +
    // senha da equipe. Quem entra assim sempre vira planejador (papel mais
    // restrito) — o coordenador promove depois se quiser. O hash enviado é
    // comparado com o hash guardado em /equipes/{id}, que só é lido aqui
    // dentro da regra — nunca exposto de volta pro cliente que está tentando
    // entrar (só quem já é membro consegue ler o documento da equipe).
    function senhaConfere(equipeId, papelAlvo) {
      return papelAlvo == 'planejador'
        && request.resource.data.senhaHash is string
        && request.resource.data.senhaHash == get(/databases/$(database)/documents/equipes/$(equipeId)).data.senhaHash;
    }
    // Índice pessoal criado depois do /membros/{uid} (nessa ordem, de
    // propósito) — em vez de mandar a senha de novo, só confirma que meu
    // próprio /membros/{uid} já existe com o hash validado.
    function jaEntreiPorSenha(equipeId) {
      return get(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid)).data.papel == 'planejador'
        && get(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid)).data.senhaHash is string;
    }

    // ------------------------------------------------------- perfil pessoal
    // Nome, preferências (tema/idioma/alertas) — não guarda mais papel, isso
    // agora é por equipe. equipesCriadas é o contador do limite de 3 equipes
    // criadas por pessoa; só muda em +1 de cada vez (via criação de equipe).
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.equipesCriadas == 0;
      allow update: if request.auth != null && request.auth.uid == uid && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome','tema','idioma','alerta','alertaTarefa','fimDeSemana'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipesCriadas'])
            && request.resource.data.equipesCriadas == resource.data.get('equipesCriadas', 0) + 1)
      );
      allow delete: if false;

      // Índice pessoal: em quais equipes eu estou e meu papel em cada uma.
      match /minhasEquipes/{equipeId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && (
          (souCoordDe(equipeId) && request.resource.data.papel == 'gp')
          || convitePraMim(equipeId, request.resource.data.papel)
          || (request.resource.data.papel == 'planejador' && jaEntreiPorSenha(equipeId))
        );
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Índice nome→id das equipes — permite checar "nome disponível" e achar
    // o id pra entrar por nome+senha, sem expor o conteúdo da equipe em si
    // (isso continua protegido por membroDe()). O id do documento é um hash
    // do nome normalizado, não o nome cru (evita problema de caractere
    // inválido em id de documento). Imutável: o "create" só é permitido se
    // o nome ainda não tiver dono; depois disso não muda nem apaga.
    match /equipeNomes/{nomeHash} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.equipeId is string
        && get(/databases/$(database)/documents/equipes/$(request.resource.data.equipeId)).data.criadoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------- equipes
    match /equipes/{equipeId} {
      allow read: if membroDe(equipeId);
      allow create: if request.auth != null
        && request.resource.data.coordenadorUid == request.auth.uid
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.senhaHash is string
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('equipesCriadas', 0) < 3;
      allow update: if souCoordDe(equipeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coordenadorUid'])
        && exists(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.resource.data.coordenadorUid));
      allow delete: if false;

      match /membros/{uid} {
        allow read: if membroDe(equipeId);
        allow create: if request.auth != null && request.auth.uid == uid && (
          (souCoordDe(equipeId) && request.resource.data.papel == 'gp')
          || convitePraMim(equipeId, request.resource.data.papel)
          || senhaConfere(equipeId, request.resource.data.papel)
        );
        allow update: if souCoordDe(equipeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papel']);
        allow delete: if souCoordDe(equipeId) || (request.auth != null && request.auth.uid == uid);
      }

      // Projetos: um documento por projeto — permite restringir o planejador
      // a só ver o que é dele.
      //  - GP/coordenador leem e escrevem qualquer projeto da equipe
      //  - planejador só lê o projeto onde é responsavelUid, e só pode mudar
      //    o campo "checklist" — nunca datas, responsável ou dados do projeto
      match /projetos/{projetoId} {
        allow read: if souGPouCoordDe(equipeId)
          || (membroDe(equipeId) && resource.data.responsavelUid == request.auth.uid);
        allow create, delete: if souGPouCoordDe(equipeId);
        allow update: if souGPouCoordDe(equipeId) || (
          membroDe(equipeId) && resource.data.responsavelUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist'])
        );

        // Chat do projeto: quem pode ver o projeto pode ver e mandar mensagem;
        // mensagem não edita nem apaga, pra manter histórico simples e real.
        match /chat/{msgId} {
          allow read: if souGPouCoordDe(equipeId)
            || (membroDe(equipeId) && get(/databases/$(database)/documents/equipes/$(equipeId)/projetos/$(projetoId)).data.responsavelUid == request.auth.uid);
          allow create: if (souGPouCoordDe(equipeId)
              || (membroDe(equipeId) && get(/databases/$(database)/documents/equipes/$(equipeId)/projetos/$(projetoId)).data.responsavelUid == request.auth.uid))
            && request.resource.data.autorUid == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }

    // Convites: coleção raiz (não subcoleção de /equipes) — assim o link
    // ?convite=CODIGO não precisa carregar o id da equipe também. Só
    // coordenador/GP da equipe alvo criam; quem consome vira membro na hora.
    match /convites/{codigo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && souGPouCoordDe(request.resource.data.equipeId)
        && request.resource.data.usado == false
        && request.resource.data.papel in ['gp', 'planejador'];
      allow update: if request.auth != null
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.papel == resource.data.papel;
      allow delete: if request.auth != null && souGPouCoordDe(resource.data.equipeId);
    }

    // Notificações — cross-equipe (uma pessoa pode estar em mais de uma
    // equipe e receber avisos de qualquer uma). Só quem gera (GP/coordenador
    // daquela equipe) cria; o destinatário só marca como lida.
    match /notificacoes/{notifId} {
      allow read: if request.auth != null && resource.data.paraUid == request.auth.uid;
      allow create: if request.auth != null
        && souGPouCoordDe(request.resource.data.equipeId)
        && request.resource.data.paraUid is string;
      allow update: if request.auth != null && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow delete: if request.auth != null && resource.data.paraUid == request.auth.uid;
    }

    // ------------------------------------------------- schema antigo (legado)
    // Antes de existir o sistema de equipes havia um workspace só. Mantido
    // só de leitura, só pro antigo coordenador, unicamente pra alimentar a
    // migração pontual (Hub → "Migrar meus dados"). O app não escreve mais
    // aqui nem lê fora da migração.
    function fuiCoordenadorAntigo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sistema/coordenador)
        && get(/databases/$(database)/documents/sistema/coordenador).data.uid == request.auth.uid;
    }
    match /sistema/coordenador {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /projetos/{projetoId} {
      allow read: if fuiCoordenadorAntigo();
      allow write: if false;
      match /chat/{msgId} {
        allow read: if fuiCoordenadorAntigo();
        allow write: if false;
      }
    }
  }
}
