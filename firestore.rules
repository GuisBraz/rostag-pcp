rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers
    // Cargos: gerente_pcp, gp, tecnico, prog_usinagem, prog_caldeiraria, cq.
    // "planejador" é o nome antigo de tecnico e continua valendo. O
    // coordenador da equipe (equipes/{id}.coordenadorUid) é sempre Gerente
    // de PCP, seja qual for o papel gravado no /membros dele.
    function papeis() {
      return ['gerente_pcp', 'gp', 'tecnico', 'prog_usinagem', 'prog_caldeiraria', 'cq'];
    }
    function membroDe(equipeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid));
    }
    function papelEm(equipeId) {
      return get(/databases/$(database)/documents/equipes/$(equipeId)/membros/$(request.auth.uid)).data.papel;
    }
    function souCoordDe(equipeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipes/$(equipeId))
        && get(/databases/$(database)/documents/equipes/$(equipeId)).data.coordenadorUid == request.auth.uid;
    }
    // Gerente de PCP: administra a equipe e vê/edita todos os projetos.
    // A Gerência pode ter várias pessoas (papel gerente_pcp). Em equipe de
    // antes dos cargos (sem papeisMigrados), quem a criou também vale.
    function equipeMigrada(equipeId) {
      return get(/databases/$(database)/documents/equipes/$(equipeId)).data.get('papeisMigrados', false) == true;
    }
    function souGerenteDe(equipeId) {
      return membroDe(equipeId) && (papelEm(equipeId) == 'gerente_pcp'
        || (souCoordDe(equipeId) && !equipeMigrada(equipeId)));
    }
    function souPapel(equipeId, papel) {
      return membroDe(equipeId) && papelEm(equipeId) == papel;
    }
    function souTecnicoDe(equipeId) {
      return membroDe(equipeId) && papelEm(equipeId) in ['tecnico', 'planejador'];
    }
    function projeto(equipeId, projetoId) {
      return get(/databases/$(database)/documents/equipes/$(equipeId)/projetos/$(projetoId)).data;
    }
    // Quem enxerga um projeto: o gerente (todos), o GP do projeto e o técnico do projeto.
    function vejoProjeto(equipeId, p) {
      return souGerenteDe(equipeId)
        || (souPapel(equipeId, 'gp') && p.get('gpUid', null) == request.auth.uid)
        || (souTecnicoDe(equipeId) && p.get('responsavelUid', null) == request.auth.uid);
    }
    // Convite válido, já consumido por mim, pra essa equipe e com esse papel —
    // usado tanto pra criar meu /membros/{uid} quanto meu índice pessoal.
    function convitePraMim(equipeId, papelAlvo) {
      return request.resource.data.viaConvite is string
        && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.equipeId == equipeId
        && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.usadoPor == request.auth.uid
        && request.resource.data.papel == papelAlvo
        && papelAlvo == get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.papel;
    }
    // Segunda forma de entrar numa equipe (além do link de convite): nome +
    // senha da equipe. Quem entra assim sempre vira técnico de processo — o
    // gerente muda o cargo depois se quiser. O cliente grava o hash digitado
    // em /equipeSegredos/{id}/entradas/{meu uid} no MESMO lote que o
    // /membros, e aqui ele é comparado (getAfter) com o hash guardado em
    // /equipeSegredos/{id}. Nenhum dos dois é legível por cliente algum.
    // Equipe antiga, sem /equipeSegredos ainda: compara com o SHA-256 puro
    // que ficava no próprio /equipes/{id} até o coordenador redefinir.
    function senhaConfere(equipeId, papelAlvo) {
      let entrada = /databases/$(database)/documents/equipeSegredos/$(equipeId)/entradas/$(request.auth.uid);
      let segredo = /databases/$(database)/documents/equipeSegredos/$(equipeId);
      return papelAlvo in ['tecnico', 'planejador']
        && existsAfter(entrada)
        && getAfter(entrada).data.senhaHash is string
        && ((exists(segredo) && getAfter(entrada).data.senhaHash == get(segredo).data.senhaHash)
          || (!exists(segredo) && getAfter(entrada).data.senhaHash
                == get(/databases/$(database)/documents/equipes/$(equipeId)).data.get('senhaHash', null)));
    }
    // Índice pessoal criado depois do /membros/{uid} (nessa ordem, de
    // propósito) — em vez de mandar a senha de novo, só confirma que meu
    // próprio /membros/{uid} já existe como técnico (e o /membros só nasce
    // por um dos caminhos validados acima).
    function jaEntreiPorSenha(equipeId) {
      return souTecnicoDe(equipeId);
    }

    // ------------------------------------------------------- perfil pessoal
    // Nome, preferências (tema/idioma/alertas) — não guarda papel, isso é
    // por equipe. equipesCriadas é o contador do limite de 3 equipes criadas
    // por pessoa; só muda em +1 de cada vez (via criação de equipe).
    match /usuarios/{uid} {
      // Só o próprio dono lê (o app nunca lista nem lê o perfil de outra
      // pessoa — nome/e-mail dos colegas vêm de /equipes/{id}/membros).
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.equipesCriadas == 0;
      allow update: if request.auth != null && request.auth.uid == uid && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome','tema','idioma','alerta','alertaTarefa','fimDeSemana'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipesCriadas'])
            && request.resource.data.equipesCriadas == resource.data.get('equipesCriadas', 0) + 1)
      );
      allow delete: if false;

      // Índice pessoal: em quais equipes eu estou e meu papel em cada uma.
      match /minhasEquipes/{equipeId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && (
          (souCoordDe(equipeId) && request.resource.data.papel in ['gerente_pcp', 'gp'])
          || convitePraMim(equipeId, request.resource.data.papel)
          || (request.resource.data.papel in ['tecnico', 'planejador'] && jaEntreiPorSenha(equipeId))
        );
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Estado dos alertas do Sistema por semana (quando apareceu, quando
      // foi lido). Só o dono lê e escreve; depois de criado só muda o lidaEm.
      match /alertas/{chave} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['semana', 'equipeId', 'alertaId', 'criadoEm', 'lidaEm'])
          && request.resource.data.semana is string
          && request.resource.data.alertaId is string && request.resource.data.alertaId.size() <= 200;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaEm']);
      }
    }

    // Índice nome→id das equipes — permite checar "nome disponível" e achar
    // o id pra entrar por nome+senha, sem expor o conteúdo da equipe em si
    // (isso continua protegido por membroDe()). O id do documento é um hash
    // do nome normalizado, não o nome cru (evita problema de caractere
    // inválido em id de documento). Imutável: o "create" só é permitido se
    // o nome ainda não tiver dono; depois disso não muda nem apaga — exceto
    // o "sal" da senha, que o coordenador troca ao redefinir a senha.
    // Só get (pelo hash do nome); listar todas as equipes não é permitido.
    match /equipeNomes/{nomeHash} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['equipeId', 'sal'])
        && request.resource.data.equipeId is string
        && request.resource.data.sal is string
        && get(/databases/$(database)/documents/equipes/$(request.resource.data.equipeId)).data.criadoPorUid == request.auth.uid;
      allow update: if souGerenteDe(resource.data.equipeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sal'])
        && request.resource.data.sal is string;
      allow delete: if false;
    }

    // Hash da senha da equipe (PBKDF2 com o sal de /equipeNomes). Ninguém lê
    // — só as regras, via get()/getAfter(). Gravado pelo coordenador: na
    // criação da equipe (mesma transação, por isso getAfter) ou ao redefinir.
    match /equipeSegredos/{equipeId} {
      allow read: if false;
      // criada junto com a equipe (pelo criador); a senha nova, qualquer gerente
      allow create, update: if request.auth != null
        && (getAfter(/databases/$(database)/documents/equipes/$(equipeId)).data.coordenadorUid == request.auth.uid
            && !exists(/databases/$(database)/documents/equipes/$(equipeId))
          || souGerenteDe(equipeId))
        && request.resource.data.keys().hasOnly(['senhaHash'])
        && request.resource.data.senhaHash is string;
      allow delete: if false;

      // Tentativa de senha de quem quer entrar pelo nome (ver senhaConfere);
      // o próprio dono grava e apaga, ninguém lê.
      match /entradas/{uid} {
        allow read: if false;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['senhaHash'])
          && request.resource.data.senhaHash is string;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------------------- equipes
    match /equipes/{equipeId} {
      allow read: if membroDe(equipeId);
      // Limite de 3 equipes criadas por pessoa: além de ler o contador, exige
      // (getAfter) que ele suba +1 na mesma transação — sem isso dava pra
      // criar equipes sem nunca incrementar. O hash da senha vai em
      // /equipeSegredos, também na mesma transação, nunca aqui.
      allow create: if request.auth != null
        && request.resource.data.coordenadorUid == request.auth.uid
        && request.resource.data.criadoPorUid == request.auth.uid
        && !('senhaHash' in request.resource.data)
        && existsAfter(/databases/$(database)/documents/equipeSegredos/$(equipeId))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('equipesCriadas', 0) < 3
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('equipesCriadas', 0)
             == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('equipesCriadas', 0) + 1;
      // Qualquer gerente: marcar a equipe como migrada (uma vez) ou apagar o
      // hash antigo (sem sal) que ficava aqui, ao redefinir a senha.
      allow update: if souGerenteDe(equipeId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papeisMigrados'])
          && request.resource.data.papeisMigrados == true)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senhaHash'])
          && !('senhaHash' in request.resource.data))
      );
      allow delete: if false;

      match /membros/{uid} {
        allow read: if membroDe(equipeId);
        allow create: if request.auth != null && request.auth.uid == uid && (
          (souCoordDe(equipeId) && request.resource.data.papel in ['gerente_pcp', 'gp'])
          || convitePraMim(equipeId, request.resource.data.papel)
          || senhaConfere(equipeId, request.resource.data.papel)
        );
        // Gerente muda o cargo de qualquer outro (inclusive de outro gerente),
        // nunca o próprio — a equipe nunca fica sem Gerência. Exceção: na
        // migração, o criador da equipe antiga grava o próprio "gerente_pcp".
        // Cada um pode atualizar o próprio nome de exibição.
        allow update: if (souGerenteDe(equipeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papel'])
            && request.resource.data.papel in papeis()
            && (uid != request.auth.uid
              || (souCoordDe(equipeId) && !equipeMigrada(equipeId) && request.resource.data.papel == 'gerente_pcp')))
          || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
            && request.resource.data.nome is string && request.resource.data.nome.size() <= 60);
        // Gerente remove os outros; cada um sai sozinho, menos gerente.
        allow delete: if (souGerenteDe(equipeId) && uid != request.auth.uid)
          || (request.auth != null && request.auth.uid == uid && !souGerenteDe(equipeId));
      }

      // Projetos: um documento por projeto.
      //  - Gerente de PCP lê e escreve todos
      //  - GP lê e escreve os projetos em que é o GP (gpUid); ao criar, vira
      //    o GP do projeto; não passa o projeto para outro GP
      //  - técnico lê o projeto onde é o responsável (responsavelUid) e só
      //    muda o campo "checklist" — nunca datas, designação ou dados
      //  - programadores leem todos (linha do tempo e carga), sem editar;
      //    o chat continua só para quem vê o projeto (vejoProjeto)
      match /projetos/{projetoId} {
        // Paralisar e cancelar são da Gerência: o GP só pede (campo "pedido",
        // em nome dele) e a Gerência aprova ou recusa. Retomar, concluir e
        // reabrir o GP faz direto.
        function statusDoGpOk() {
          return request.resource.data.get('status', 'ativo') == resource.data.get('status', 'ativo')
            || request.resource.data.get('status', 'ativo') in ['ativo', 'concluido'];
        }
        function pedidoDoGpOk() {
          return request.resource.data.get('pedido', null) == resource.data.get('pedido', null)
            || request.resource.data.get('pedido', null) == null
            || (request.resource.data.pedido.tipo in ['paralisar', 'cancelar']
              && request.resource.data.pedido.porUid == request.auth.uid
              && request.resource.data.pedido.motivo is string
              && request.resource.data.pedido.motivo.size() > 0 && request.resource.data.pedido.motivo.size() <= 200);
        }
        allow read: if vejoProjeto(equipeId, resource.data)
          || souPapel(equipeId, 'prog_usinagem') || souPapel(equipeId, 'prog_caldeiraria');
        allow create: if souGerenteDe(equipeId)
          || (souPapel(equipeId, 'gp') && request.resource.data.gpUid == request.auth.uid
            && request.resource.data.get('status', 'ativo') in ['ativo', 'concluido']
            && request.resource.data.get('pedido', null) == null);
        allow update: if souGerenteDe(equipeId)
          || (souPapel(equipeId, 'gp') && resource.data.get('gpUid', null) == request.auth.uid
            && request.resource.data.get('gpUid', null) == request.auth.uid
            && statusDoGpOk() && pedidoDoGpOk())
          || (souTecnicoDe(equipeId) && resource.data.get('responsavelUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist']));
        allow delete: if souGerenteDe(equipeId)
          || (souPapel(equipeId, 'gp') && resource.data.get('gpUid', null) == request.auth.uid);

        // Chat do projeto: quem pode ver o projeto pode ver e mandar mensagem;
        // mensagem não edita nem apaga, pra manter histórico simples e real.
        match /chat/{msgId} {
          allow read: if vejoProjeto(equipeId, projeto(equipeId, projetoId));
          allow create: if vejoProjeto(equipeId, projeto(equipeId, projetoId))
            && request.resource.data.autorUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['autorUid', 'autorNome', 'texto', 'criadoEm'])
            && request.resource.data.texto is string
            && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000;
          allow update, delete: if false;
        }
      }

      // Ordens de produção: uma por peça (desenho + posição) e área. Guardam
      // cópia do GP e do técnico do projeto para decidir quem vê:
      //  - gerente e CQ: todas · programador: as da área dele
      //  - GP e técnico: as dos projetos deles
      // Quem sobe a planilha (técnico do projeto ou gerente) cria e atualiza
      // os dados da peça, nunca a finalização. O CQ finaliza uma vez só
      // (Aprovada ou RNC com observação) e não desfaz.
      match /ops/{opId} {
        function camposOp() {
          return ['projetoId', 'commessa', 'cliente', 'descricaoProjeto', 'gpUid', 'tecnicoUid', 'area', 'numero',
                  'desenho', 'posicao', 'rev', 'descricao', 'qtd', 'pesoUnit', 'pesoTotal', 'status',
                  'criadoEm', 'criadoPorUid', 'atualizadoEm'];
        }
        function camposDados() {
          return ['numero', 'desenho', 'posicao', 'rev', 'descricao', 'qtd', 'pesoUnit', 'pesoTotal',
                  'commessa', 'cliente', 'descricaoProjeto', 'gpUid', 'tecnicoUid', 'atualizadoEm'];
        }
        function souTecnicoDoProjeto(p) {
          return souTecnicoDe(equipeId) && p.get('responsavelUid', null) == request.auth.uid;
        }
        // GP e técnico copiados do projeto precisam bater com o projeto atual.
        function designacaoConfere(d, p) {
          return d.gpUid == p.get('gpUid', null) && d.tecnicoUid == p.get('responsavelUid', null);
        }
        allow read: if souGerenteDe(equipeId) || souPapel(equipeId, 'cq')
          || (souPapel(equipeId, 'prog_usinagem') && resource.data.area == 'usinagem')
          || (souPapel(equipeId, 'prog_caldeiraria') && resource.data.area == 'caldeiraria')
          || (souPapel(equipeId, 'gp') && resource.data.gpUid == request.auth.uid)
          || (souTecnicoDe(equipeId) && resource.data.tecnicoUid == request.auth.uid);
        // Pela planilha (técnico do projeto ou gerente) ou, no retrabalho, pelo
        // CQ: OP nova ligada à original, que vira peça morta no mesmo lote.
        allow create: if request.resource.data.projetoId is string
          && designacaoConfere(request.resource.data, projeto(equipeId, request.resource.data.projetoId))
          && request.resource.data.status == 'aberta'
          && request.resource.data.numero is string
          && request.resource.data.numero.size() > 0 && request.resource.data.numero.size() <= 40
          && request.resource.data.criadoPorUid == request.auth.uid
          && (
            ((souGerenteDe(equipeId) || souTecnicoDoProjeto(projeto(equipeId, request.resource.data.projetoId)))
              && request.resource.data.keys().hasOnly(camposOp())
              && request.resource.data.area in ['caldeiraria', 'usinagem'])
            || (souPapel(equipeId, 'cq')
              && request.resource.data.keys().hasOnly(camposOp().concat(['origemOpId', 'origemRncId']))
              && request.resource.data.origemOpId is string
              && get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.origemOpId)).data.status in ['retrabalho', 'rnc']
              && getAfter(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.origemOpId)).data.status == 'morta'
              && get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.origemOpId)).data.projetoId == request.resource.data.projetoId
              && get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.origemOpId)).data.area == request.resource.data.area)
          );
        allow update: if (
            (souGerenteDe(equipeId) || souTecnicoDoProjeto(projeto(equipeId, resource.data.projetoId))
              || (souPapel(equipeId, 'gp') && projeto(equipeId, resource.data.projetoId).get('gpUid', null) == request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 (souPapel(equipeId, 'gp') ? ['gpUid', 'tecnicoUid'] : camposDados()))
            && designacaoConfere(request.resource.data, projeto(equipeId, resource.data.projetoId))
            && request.resource.data.numero is string
            && request.resource.data.numero.size() > 0 && request.resource.data.numero.size() <= 40
          ) || (
            // carga máquina: o programador de usinagem (ou o gerente) escolhe a
            // máquina e as horas previstas de uma OP de usinagem
            (souPapel(equipeId, 'prog_usinagem') || souGerenteDe(equipeId))
            && resource.data.area == 'usinagem'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['maquinaId', 'horasPrevistas', 'programadoEm', 'programadoPorUid'])
            && (request.resource.data.get('maquinaId', null) == null || request.resource.data.maquinaId is string)
            && (request.resource.data.get('horasPrevistas', null) == null
              || (request.resource.data.horasPrevistas is number
                && request.resource.data.horasPrevistas >= 0 && request.resource.data.horasPrevistas <= 10000))
            && request.resource.data.programadoPorUid == request.auth.uid
          ) || (
            // Controle de qualidade. Da OP aberta ou em retrabalho:
            //  → aprovada (aberta ou retrabalho) / desvio (só do retrabalho)
            //  → retrabalho, apontando para a RNC que existe depois deste lote
            //  → morta (só do retrabalho), com a OP nova já criada no lote
            // Aprovada, desvio e morta são finais: o CQ não desfaz.
            souPapel(equipeId, 'cq') && resource.data.status in ['aberta', 'retrabalho', 'rnc']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'finalizadoPorUid', 'finalizadoPorNome', 'finalizadoEm',
                           'rncAtualId', 'rncNumero', 'retrabalhoDesde', 'mortaEm', 'opNovaId', 'opNovaNumero'])
            && (
              (request.resource.data.status == 'aprovada'
                || (request.resource.data.status == 'desvio' && resource.data.status in ['retrabalho', 'rnc']))
                && request.resource.data.finalizadoPorUid == request.auth.uid
                && request.resource.data.finalizadoEm is string
              || (request.resource.data.status == 'retrabalho'
                && request.resource.data.rncAtualId is string
                && existsAfter(/databases/$(database)/documents/equipes/$(equipeId)/rncs/$(request.resource.data.rncAtualId)))
              || (request.resource.data.status == 'morta' && resource.data.status in ['retrabalho', 'rnc']
                && request.resource.data.opNovaId is string
                && existsAfter(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opNovaId))
                && request.resource.data.mortaEm is string)
            )
          );
        allow delete: if souGerenteDe(equipeId)
          || (souTecnicoDe(equipeId) && resource.data.tecnicoUid == request.auth.uid && resource.data.status == 'aberta');
      }

      // Registro de Não Conformidade (formulário R02), ligado a uma OP. Só o
      // CQ abre e preenche; ao abrir, a OP vai para "retrabalho" apontando
      // para esta RNC no mesmo lote. Gerência e CQ leem todas; GP e técnico,
      // as dos projetos deles. Nunca se apaga (é registro da qualidade).
      match /rncs/{rncId} {
        function camposForm() {
          return ['numero', 'produto', 'desenho', 'rev', 'commessa', 'op', 'qtd', 'tag', 'item', 'setor', 'setorOutros',
                  'procedencia', 'descricao', 'inspetor', 'qtdNc', 'data', 'disposicao', 'dispResponsavel', 'dispData',
                  'reOp', 'reInspetor', 'reData', 'reResultado', 'reResponsavel', 'observacoes', 'situacao', 'atualizadoEm'];
        }
        function textosOk(d) {
          return d.numero is string && d.numero.size() > 0 && d.numero.size() <= 30
            && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 3000
            && d.disposicao is string && d.disposicao.size() <= 3000
            && d.observacoes is string && d.observacoes.size() <= 6000
            && d.situacao in ['aberta', 'encerrada'];
        }
        allow read: if souGerenteDe(equipeId) || souPapel(equipeId, 'cq')
          || (souPapel(equipeId, 'gp') && resource.data.gpUid == request.auth.uid)
          || (souTecnicoDe(equipeId) && resource.data.tecnicoUid == request.auth.uid);
        allow create: if souPapel(equipeId, 'cq')
          && request.resource.data.keys().hasOnly(camposForm().concat(['opId', 'projetoId', 'area', 'gpUid', 'tecnicoUid',
               'criadoPorUid', 'criadoPorNome', 'criadoEm']))
          && textosOk(request.resource.data)
          && request.resource.data.criadoPorUid == request.auth.uid
          && request.resource.data.opId is string
          && get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opId)).data.status in ['aberta', 'retrabalho', 'rnc']
          && getAfter(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opId)).data.rncAtualId == rncId
          && request.resource.data.projetoId == get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opId)).data.projetoId
          && request.resource.data.gpUid == get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opId)).data.gpUid
          && request.resource.data.tecnicoUid == get(/databases/$(database)/documents/equipes/$(equipeId)/ops/$(request.resource.data.opId)).data.tecnicoUid;
        allow update: if souPapel(equipeId, 'cq')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposForm())
          && textosOk(request.resource.data);
        allow delete: if false;
      }

      // Máquinas da usinagem (carga máquina): toda a equipe lê; o programador
      // de usinagem e o gerente cadastram, editam e apagam.
      match /maquinas/{maquinaId} {
        allow read: if membroDe(equipeId);
        allow create, update: if (souPapel(equipeId, 'prog_usinagem') || souGerenteDe(equipeId))
          && request.resource.data.keys().hasOnly(['nome', 'horasDia', 'ativa', 'criadoEm', 'atualizadoEm'])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
          && request.resource.data.horasDia is number
          && request.resource.data.horasDia > 0 && request.resource.data.horasDia <= 24
          && request.resource.data.ativa is bool;
        allow delete: if souPapel(equipeId, 'prog_usinagem') || souGerenteDe(equipeId);
      }

      // Configuração da fábrica (carga fábrica): capacidade da caldeiraria em
      // kg por semana. Toda a equipe lê; programador de caldeiraria e gerente gravam.
      match /config/{doc} {
        allow read: if membroDe(equipeId);
        allow create, update: if doc == 'fabrica'
          && (souPapel(equipeId, 'prog_caldeiraria') || souGerenteDe(equipeId))
          && request.resource.data.keys().hasOnly(['capacidadeKgSemana', 'atualizadoEm', 'atualizadoPorUid'])
          && request.resource.data.capacidadeKgSemana is number
          && request.resource.data.capacidadeKgSemana > 0 && request.resource.data.capacidadeKgSemana <= 10000000
          && request.resource.data.atualizadoPorUid == request.auth.uid;
        allow delete: if false;
      }
    }

    // Convites: coleção raiz (não subcoleção de /equipes) — assim o link
    // ?convite=CODIGO não precisa carregar o id da equipe também. Só o
    // Gerente de PCP da equipe alvo cria; quem consome vira membro na hora,
    // já com o cargo do convite. Ler um convite pelo código (get) é livre pra
    // quem está logado — o código é o segredo. Listar (list) só a própria
    // equipe, e a consulta precisa filtrar where('equipeId', '==', …).
    // Validade: o convite vale 7 dias a partir de emitidoEm, que é a hora do
    // servidor (serverTimestamp — o cliente não escolhe a data). Convite sem
    // emitidoEm (criado antes da validade existir) já não pode ser usado.
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow list: if souGerenteDe(resource.data.equipeId);
      allow create: if request.auth != null
        && souGerenteDe(request.resource.data.equipeId)
        && request.resource.data.usado == false
        && request.resource.data.papel in papeis()
        && request.resource.data.emitidoEm == request.time;
      // Consumir: só marca como usado por mim — equipe, papel e emitidoEm
      // não mudam, e só dentro da validade.
      allow update: if request.auth != null
        && resource.data.usado == false
        && request.time < resource.data.emitidoEm + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usadoPor', 'usadoEm'])
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid;
      allow delete: if request.auth != null && souGerenteDe(resource.data.equipeId);
    }

    // Notificações — cross-equipe (uma pessoa pode estar em mais de uma
    // equipe e receber avisos de qualquer uma). Qualquer membro avisa outro
    // membro da mesma equipe, em nome próprio; o destinatário só marca como
    // lida (e quando) ou apaga.
    match /notificacoes/{notifId} {
      allow read: if request.auth != null && resource.data.paraUid == request.auth.uid;
      allow create: if request.auth != null
        && membroDe(request.resource.data.equipeId)
        && request.resource.data.keys().hasOnly(['paraUid', 'tipo', 'mensagem', 'projetoId', 'equipeId', 'deUid', 'deNome', 'lida', 'criadoEm'])
        && request.resource.data.paraUid is string
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.tipo in ['designacao', 'observacao', 'projetoCriado', 'cronograma', 'datas',
                                          'designacaoTrocada', 'planilhaOps', 'rnc', 'chat', 'pedido', 'pedidoAprovado', 'pedidoRecusado']
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && (request.resource.data.projetoId == null || request.resource.data.projetoId is string)
        && request.resource.data.lida == false
        && exists(/databases/$(database)/documents/equipes/$(request.resource.data.equipeId)/membros/$(request.resource.data.paraUid));
      allow update: if request.auth != null && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lidaEm']);
      allow delete: if request.auth != null && resource.data.paraUid == request.auth.uid;
    }

    // ------------------------------------------------- schema antigo (legado)
    // Antes de existir o sistema de equipes havia um workspace só. Mantido
    // só de leitura, só pro antigo coordenador, unicamente pra alimentar a
    // migração pontual (Hub → "Migrar meus dados"). O app não escreve mais
    // aqui nem lê fora da migração.
    function fuiCoordenadorAntigo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sistema/coordenador)
        && get(/databases/$(database)/documents/sistema/coordenador).data.uid == request.auth.uid;
    }
    match /sistema/coordenador {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /projetos/{projetoId} {
      allow read: if fuiCoordenadorAntigo();
      allow write: if false;
      match /chat/{msgId} {
        allow read: if fuiCoordenadorAntigo();
        allow write: if false;
      }
    }
  }
}
