rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O coordenador é definido por um único documento (sistema/coordenador),
    // não por um campo em cada perfil — assim nunca existe ambiguidade sobre
    // quem manda, e transferir o cargo é só trocar esse um valor.
    function souCoordenador() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sistema/coordenador)
        && get(/databases/$(database)/documents/sistema/coordenador).data.uid == request.auth.uid;
    }

    // Membro = logado + tem perfil em /usuarios. Não existe "pendente": ou
    // a pessoa entrou (primeira do sistema, ou usando um convite válido do
    // coordenador) e já é membro pleno, ou não tem perfil nenhum.
    function membro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function meuPapel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }

    // Coordenador e GP têm o mesmo poder de edição — criam projeto, designam
    // quem cuida de cada um, mexem em qualquer campo. Planejador só mexe no
    // que for designado a ele, e só nas tarefas (ver regra de /projetos).
    function souGPouCoordenador() {
      return membro() && (souCoordenador() || meuPapel() == 'gp');
    }

    // O documento único que diz quem é o coordenador atual.
    match /sistema/coordenador {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/sistema/coordenador)
        && request.resource.data.uid == request.auth.uid;
      allow update: if souCoordenador()
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid));
    }

    // Convites: só coordenador/GP criam. Quem se cadastra com um código
    // válido (não usado) vira membro na hora, já com o papel do convite.
    match /convites/{codigo} {
      allow read: if request.auth != null;
      allow create: if souGPouCoordenador() && request.resource.data.usado == false
        && request.resource.data.papel in ['gp', 'planejador'];
      allow update: if request.auth != null
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid;
      allow delete: if souGPouCoordenador();
    }

    // Perfis de usuário (nome, preferências, papel):
    //  - qualquer logado lê a lista inteira (alimenta a aba Equipe)
    //  - um usuário cria o próprio perfil só se for o primeiro do sistema
    //    (vira coordenador+gp) OU consumindo um convite válido na mesma
    //    transação, herdando o papel gravado no convite
    //  - o dono edita as próprias preferências, MAS não o próprio papel —
    //    só o coordenador muda papel ou remove alguém
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && (
        (!exists(/databases/$(database)/documents/sistema/coordenador) && request.resource.data.papel == 'gp')
        || (request.resource.data.viaConvite is string
            && exists(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite))
            && get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.usado == false
            && request.resource.data.papel == get(/databases/$(database)/documents/convites/$(request.resource.data.viaConvite)).data.papel)
      );
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.papel == resource.data.papel)
        || souCoordenador()
      );
      allow delete: if souCoordenador();
    }

    // Projetos: um documento por projeto (não um array num blob só) — é o
    // que permite restringir o planejador a só ver o que é dele.
    //  - GP/coordenador leem e escrevem qualquer projeto, qualquer campo
    //  - planejador só lê o projeto onde é responsavelUid, e só pode mudar
    //    o campo "checklist" (marcar tarefa feita, escrever observação) —
    //    nunca datas, responsável ou dados do projeto em si
    match /projetos/{projetoId} {
      allow read: if souGPouCoordenador()
        || (membro() && resource.data.responsavelUid == request.auth.uid);
      allow create, delete: if souGPouCoordenador();
      allow update: if souGPouCoordenador() || (
        membro() && resource.data.responsavelUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist'])
      );

      // Chat do projeto: quem pode ver o projeto pode ver e mandar mensagem;
      // mensagem não edita nem apaga, pra manter histórico simples e real.
      match /chat/{msgId} {
        allow read: if souGPouCoordenador()
          || (membro() && get(/databases/$(database)/documents/projetos/$(projetoId)).data.responsavelUid == request.auth.uid);
        allow create: if (souGPouCoordenador()
            || (membro() && get(/databases/$(database)/documents/projetos/$(projetoId)).data.responsavelUid == request.auth.uid))
          && request.resource.data.autorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Notificações — de designação de projeto ou de observação numa tarefa.
    // Só quem gerou (GP/coordenador) cria; o destinatário só marca como lida.
    match /notificacoes/{notifId} {
      allow read: if membro() && resource.data.paraUid == request.auth.uid;
      allow create: if souGPouCoordenador() && request.resource.data.paraUid is string;
      allow update: if membro() && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow delete: if membro() && resource.data.paraUid == request.auth.uid;
    }
  }
}
